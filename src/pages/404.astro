---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site';
---

<Layout 
  title={`404 - Page Not Found | ${siteConfig.name}`}
  description="The requested page could not be located on this cluster. Return to Siddharth Ganjoo's homepage or explore interactive projects."
>
  <div class="not-found-container">
    <div class="not-found-card glass-card">
      <span class="not-found-badge">
        <i class="fas fa-triangle-exclamation"></i> ROUTE 404 // CLUSTER OFFLINE
      </span>
      
      <div class="not-found-code gradient-text">404</div>
      <h1 class="not-found-title">Compute Node Not Found</h1>
      <p class="not-found-desc">
        The requested URL coordinate does not exist on this cluster or was relocated during an infrastructure update.
      </p>

      <div class="not-found-actions">
        <a href="./index.html" class="btn btn-primary">
          <i class="fas fa-house"></i> Return to Homepage
        </a>
        <a href="./index.html#lab" class="btn btn-secondary">
          <i class="fas fa-bolt"></i> Launch SNN Lab
        </a>
        <a href="./index.html#projects" class="btn btn-secondary">
          <i class="fas fa-layer-group"></i> View Projects
        </a>
      </div>
    </div>
  </div>
</Layout>
