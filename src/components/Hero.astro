---
import { siteConfig } from '../data/site';
import Terminal from './Terminal.astro';
---

<section id="hero" class="hero">
  <div class="hero-container">
    <div class="hero-profile">
      <img 
        src="assets/pp.JPG" 
        alt={`Portrait of ${siteConfig.name}, Machine Learning Engineer`} 
        class="profile-image" 
        width="104" 
        height="104" 
        loading="eager" 
        fetchpriority="high" 
        decoding="async" 
      />
    </div>
    
    <div class="hero-badge">
      <span class="status-dot"></span>
      <span>Machine Learning Engineer // Spike-A @ AI-SIB (TU/e)</span>
    </div>
    
    <h1 class="hero-title">
      Hi, I'm <span class="gradient-text">{siteConfig.name}</span>
    </h1>
    <p class="hero-subtitle">{siteConfig.role}</p>
    <p class="hero-description">
      Scaling distributed AI and high-performance deep learning on the <strong>Spike-A supercomputer</strong> within the <strong>AI Supercomputing Initiative Brabant (AI-SIB)</strong> at <strong>TU Eindhoven</strong>. 
      Previously engineered telemetry pipelines at <strong>Vencomatic Group</strong>, and automated computer vision solutions as Co-Founder &amp; CTO of <strong>Loopit.ai</strong>.
    </p>
    
    <div class="hero-stats">
      {siteConfig.stats.map(stat => (
        <div class="stat-item glass-card">
          <div class="stat-value gradient-text">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
    
    <div class="hero-actions">
      <a href="#lab" class="btn btn-primary hero-lab-cta">
        <i class="fas fa-bolt"></i> Interactive SNN Lab
      </a>
      <a href="#projects" class="btn btn-secondary">
        <i class="fas fa-layer-group"></i> Selected Projects
      </a>
      <button type="button" class="btn btn-secondary" id="hero-terminal-toggle" aria-expanded="false">
        <i class="fas fa-terminal"></i> Terminal CLI
        <span class="badge-term-dot"></span>
      </button>
      <a href={siteConfig.resumeUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
        <i class="fas fa-file-pdf"></i> Resume
      </a>
    </div>

    <!-- Collapsible Interactive Terminal Console Widget -->
    <div class="hero-terminal-drawer" id="hero-terminal-drawer">
      <Terminal />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.25rem 2.25rem;
    text-align: center;
    position: relative;
  }

  .hero-container {
    max-width: 780px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-profile {
    margin-bottom: 0.85rem;
    display: flex;
    justify-content: center;
  }

  .profile-image {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
    margin: 0 auto;
    border: 3px solid var(--border);
    box-shadow: 0 6px 24px var(--shadow);
    transition: transform 0.25s var(--ease-smooth), box-shadow 0.25s var(--ease-smooth), border-color 0.2s;
  }

  .profile-image:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 32px var(--shadow-glow);
    border-color: var(--accent);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.95rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 50px;
    font-size: 0.775rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    box-shadow: 0 1px 3px var(--shadow);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--success);
    border-radius: 50%;
    position: relative;
    box-shadow: 0 0 6px var(--success);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: -2.5px;
    border-radius: 50%;
    background: var(--success);
    opacity: 0.4;
    animation: pulseDot 2s infinite ease-out;
  }

  @keyframes pulseDot {
    0% { transform: scale(1); opacity: 0.5; }
    70% { transform: scale(2.2); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
  }

  .hero-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
    line-height: 1.1;
    color: var(--text);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 0.65rem;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 660px;
    margin: 0 auto 1.25rem;
    line-height: 1.6;
  }

  .hero-description strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.65rem;
    max-width: 720px;
    margin: 1.25rem auto;
  }

  .stat-item {
    text-align: center;
    border-radius: 12px;
    padding: 0.75rem 0.5rem;
    transition: transform 0.2s, border-color 0.2s;
  }

  .stat-item:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .stat-value {
    font-size: 1.55rem;
    font-weight: 800;
    margin-bottom: 0.1rem;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.725rem;
    color: var(--text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .hero-actions {
    display: flex;
    gap: 0.65rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .hero-lab-cta {
    background: linear-gradient(135deg, #0284c7 0%, #6366f1 100%) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 18px rgba(2, 132, 199, 0.35);
  }

  .hero-lab-cta:hover {
    box-shadow: 0 6px 24px rgba(99, 102, 241, 0.5);
    transform: translateY(-2px);
  }

  .badge-term-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
    display: inline-block;
  }

  .hero-terminal-drawer {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, margin-top 0.3s ease;
    margin-top: 0;
  }

  .hero-terminal-drawer.open {
    max-height: 800px;
    opacity: 1;
    margin-top: 1.25rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 1rem 2rem;
    }
    
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-stats {
      grid-template-columns: 1fr;
    }
    
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  const termToggle = document.getElementById('hero-terminal-toggle');
  const termDrawer = document.getElementById('hero-terminal-drawer');

  if (termToggle && termDrawer) {
    termToggle.addEventListener('click', () => {
      const isOpen = termDrawer.classList.toggle('open');
      termToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (isOpen) {
        termToggle.classList.add('active');
        const termInput = document.getElementById('terminal-input') as HTMLInputElement | null;
        setTimeout(() => termInput?.focus(), 250);
      } else {
        termToggle.classList.remove('active');
      }
    });
  }
</script>
