---
import { siteConfig } from '../data/site';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname.endsWith('/index.html') || pathname === '';
---

<nav class="nav">
  <!-- Top Scroll Progress Indicator -->
  <div class="scroll-progress-bar" id="scroll-progress"></div>

  <div class="nav-container">
    <a href={isHome ? "#hero" : "./index.html#hero"} class="nav-logo">
      <span class="logo-badge">{siteConfig.initials}</span>
      <span class="nav-logo-text">{siteConfig.name}</span>
    </a>

    <!-- Live Status & Clock Pill -->
    <div class="nav-status-pill">
      <span class="status-pulsing-dot"></span>
      <span id="nav-time-display">Eindhoven, NL</span>
    </div>
    
    <ul class="nav-menu">
      {siteConfig.navLinks.map(link => (
        <li class="nav-item">
          <a href={isHome ? link.href : `./index.html${link.href}`} class="nav-link">{link.label}</a>
        </li>
      ))}

      <!-- Command Palette Trigger Button -->
      <li class="nav-item">
        <button type="button" class="nav-cmd-trigger" data-trigger-cmd aria-label="Open command palette (Cmd+K)">
          <i class="fas fa-search"></i>
          <span class="cmd-kbd-label">⌘K</span>
        </button>
      </li>

      <li class="nav-item">
        <a href={siteConfig.resumeUrl} class="nav-link nav-cta" target="_blank" rel="noopener noreferrer">
          <i class="fas fa-file-pdf"></i> Resume
        </a>
      </li>

      <li class="nav-item">
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
          <i class="fas fa-sun theme-icon sun"></i>
          <i class="fas fa-moon theme-icon moon"></i>
        </button>
      </li>
    </ul>
    
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .scroll-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 2.5px;
    width: 0%;
    background: var(--accent-gradient);
    z-index: 1001;
    transition: width 0.1s linear;
  }

  :global([data-theme="dark"]) .nav {
    background: rgba(7, 9, 14, 0.85);
  }

  .nav.scrolled {
    box-shadow: 0 4px 14px var(--shadow);
  }

  .nav-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-logo {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: var(--accent-gradient);
    color: #ffffff;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.8rem;
    box-shadow: 0 1px 4px var(--shadow);
  }

  .nav-status-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 50px;
    padding: 0.25rem 0.65rem;
    font-size: 0.725rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .status-pulsing-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    position: relative;
    transition: color 0.2s ease;
    padding: 0.2rem 0;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width 0.2s var(--ease-smooth);
    border-radius: 2px;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-cmd-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-cmd-trigger:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cmd-kbd-label {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .nav-cta {
    padding: 0.35rem 1rem;
    background: var(--text);
    color: var(--bg) !important;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.8125rem;
    transition: transform 0.2s ease, opacity 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .nav-cta::after {
    display: none !important;
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--border);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text);
    transition: background 0.2s, transform 0.2s;
  }

  .theme-toggle:hover {
    background: var(--card-bg);
    transform: scale(1.05);
  }

  .theme-icon {
    font-size: 13px;
  }

  .theme-icon.moon {
    display: block;
  }
  .theme-icon.sun {
    display: none;
  }

  :global([data-theme="dark"]) .theme-icon.moon {
    display: none;
  }
  :global([data-theme="dark"]) .theme-icon.sun {
    display: block;
  }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    border-radius: 5px;
  }

  .nav-hamburger span {
    width: 20px;
    height: 2px;
    background: var(--text);
    transition: all 0.2s;
    border-radius: 2px;
  }

  .nav-hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }
  .nav-hamburger.active span:nth-child(2) {
    opacity: 0;
  }
  .nav-hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  @media (max-width: 900px) {
    .nav-status-pill {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .nav-menu {
      position: fixed;
      top: 60px;
      right: -100%;
      flex-direction: column;
      background: var(--bg);
      width: 80%;
      height: calc(100vh - 60px);
      padding: 1.5rem 1.25rem;
      border-left: 1px solid var(--border);
      transition: right 0.25s;
      align-items: flex-start;
      overflow-y: auto;
    }
    
    .nav-menu.active {
      right: 0;
    }
    
    .nav-hamburger {
      display: flex;
    }
  }
</style>

<script>
  // Live Clock for Eindhoven Time
  function updateEindhovenClock() {
    const el = document.getElementById('nav-time-display');
    if (!el) return;
    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Europe/Amsterdam',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    };
    const timeStr = now.toLocaleTimeString('en-GB', options);
    el.textContent = `Eindhoven, NL • ${timeStr} CET`;
  }
  updateEindhovenClock();
  setInterval(updateEindhovenClock, 30000);

  // Theme Switcher
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }

  // Header elevation & reading progress on scroll
  const nav = document.querySelector('.nav');
  const progressBar = document.getElementById('scroll-progress');
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (nav) {
      if (scrollY > 20) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    }
    if (progressBar) {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }
  }, { passive: true });

  // Active section indicator
  const navLinks = document.querySelectorAll('.nav-link[href^="#"]');
  const sections = document.querySelectorAll('section[id]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navLinks.forEach(link => {
          if (link.getAttribute('href') === `#${id}`) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    });
  }, { threshold: 0.25, rootMargin: '-80px 0px -50% 0px' });
  sections.forEach(sec => observer.observe(sec));

  // Mobile Menu
  const hamburger = document.getElementById('nav-hamburger');
  const navMenu = document.querySelector('.nav-menu');
  if (hamburger && navMenu) {
    hamburger.addEventListener('click', () => {
      const isActive = navMenu.classList.toggle('active');
      hamburger.classList.toggle('active');
      document.body.style.overflow = isActive ? 'hidden' : '';
    });

    document.querySelectorAll('.nav-menu a').forEach(link => {
      link.addEventListener('click', () => {
        navMenu.classList.remove('active');
        hamburger.classList.remove('active');
        document.body.style.overflow = '';
      });
    });
  }
</script>
