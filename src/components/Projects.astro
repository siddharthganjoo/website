---
import { projectsData } from '../data/projects';
import { siteConfig } from '../data/site';
---

<section id="projects" class="section projects-section">
  <div class="section-container">
    <div class="section-header">
      <span class="section-eyebrow">Portfolio</span>
      <h2 class="section-title">Selected Projects</h2>
      <p class="section-description">Research and commercial machine learning systems driving measurable impact</p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="projects-filters">
      <button type="button" class="project-filter-btn active" data-cat="all">
        All Work ({projectsData.length})
      </button>
      <button type="button" class="project-filter-btn" data-cat="hpc">
        <i class="fas fa-server"></i> Supercomputing
      </button>
      <button type="button" class="project-filter-btn" data-cat="cv">
        <i class="fas fa-eye"></i> Computer Vision
      </button>
      <button type="button" class="project-filter-btn" data-cat="rl">
        <i class="fas fa-chart-line"></i> Reinforcement Learning
      </button>
      <button type="button" class="project-filter-btn" data-cat="nlp">
        <i class="fas fa-brain"></i> LLMs &amp; NLP
      </button>
    </div>
    
    <div class="projects-grid">
      {projectsData.map(project => (
        <div class={`project-card ${project.isFeatured ? 'featured' : ''}`} data-category={project.category}>
          <div class="project-image">
            <img 
              src={project.image} 
              alt={`Architecture diagram and preview of ${project.title}`} 
              loading="lazy" 
              decoding="async" 
              width="400" 
              height="200" 
            />
          </div>
          <div class="project-content">
            <div>
              <span class="project-tag">{project.tag}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="project-impact">
                {project.impact.map(imp => (
                  <span>{imp}</span>
                ))}
              </div>
            </div>
            {project.links && project.links.length > 0 && (
              <div class="project-links">
                {project.links.map(link => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    
    <div class="section-footer">
      <a href={`${siteConfig.socials.github}?tab=repositories`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        View all on GitHub →
      </a>
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .project-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s var(--ease-smooth), box-shadow 0.2s var(--ease-smooth);
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px var(--shadow-lg);
    border-color: var(--accent);
  }

  .project-card.featured {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
  }

  .project-image {
    height: 200px;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .project-card.featured .project-image {
    height: 100%;
    min-height: 220px;
    border-bottom: none;
    border-right: 1px solid var(--border);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s var(--ease-smooth);
  }

  .project-card:hover .project-image img {
    transform: scale(1.025);
  }

  .project-content {
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
  }

  .project-tag {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 50px;
    font-size: 0.675rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
    color: var(--accent);
    align-self: flex-start;
  }

  .project-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--text);
    line-height: 1.3;
  }

  .project-content p {
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .project-impact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .project-impact span {
    padding: 0.25rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text);
  }

  .project-links {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
  }

  .project-links a {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.85rem;
    transition: opacity 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .project-links a:hover {
    opacity: 0.75;
    transform: translateX(2px);
  }

  .section-footer {
    text-align: center;
    margin-top: 1.5rem;
  }

  .projects-filters {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .project-filter-btn {
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.775rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .project-filter-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .project-filter-btn.active {
    background: var(--accent-light);
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 10px var(--shadow-glow);
  }

  .project-card.is-hidden {
    display: none !important;
  }

  @media (max-width: 1024px) {
    .project-card.featured {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }

    .project-card.featured .project-image {
      border-right: none;
      border-bottom: 1px solid var(--border);
      height: 190px;
    }
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Project Category Filter Handler
  const projectFilters = document.querySelectorAll('.project-filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  projectFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      projectFilters.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const cat = btn.getAttribute('data-cat');

      projectCards.forEach(card => {
        const itemCat = card.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });
    });
  });
</script>

